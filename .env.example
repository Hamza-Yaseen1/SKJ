# ─────────────────────────────────────────────────────────────
# SKJ Pure Presence · environment variables
# Copy this file to `.env.local` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Email provider — Resend (https://resend.com)
# Create an API key in the Resend dashboard → API Keys.
RESEND_API_KEY=

# Sender shown on the "From" line of every email.
# The domain must be verified in your Resend dashboard.
EMAIL_FROM="SKJ Pure Presence <orders@your-domain.com>"

# Store owner inbox — new-order notifications are delivered here.
STORE_EMAIL="atelier@your-domain.com"

# ── Optional ──

# Canonical site URL (used for SEO metadata / Open Graph absolute URLs).
# Also set this in your Vercel project settings.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Dev/testing only — when "true", "sends" fake emails without calling Resend,
# so the checkout flow works locally without an API key.
EMAIL_DRY_RUN="true"