# ─────────────────────────────────────────────────────────────
# SKJ Pure Presence · environment variables
# Copy this file to `.env.local` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Email provider — Brevo (formerly Sendinblue, https://www.brevo.com)
# Create an API key in the Brevo dashboard → SMTP & API → API Keys.
# Only the "smtp" scope is needed for transactional order emails.
BREVO_API_KEY=

# Sender shown on the "From" line of every email.
# The sender email/domain must be verified in your Brevo dashboard.
EMAIL_FROM="SKJ Pure Presence <orders@your-domain.com>"

# Store owner inbox — new-order notifications are delivered here.
OWNER_EMAIL="atelier@your-domain.com"

# ── Optional ──

# Canonical site URL (used for SEO metadata / Open Graph absolute URLs).
# Also set this in your Vercel project settings.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Dev/testing only — when "true", "sends" fake emails without calling Brevo,
# so the checkout flow works locally without an API key.
EMAIL_DRY_RUN="true"